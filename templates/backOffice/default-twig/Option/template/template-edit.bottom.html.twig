{# Paid options block on the product-template edit page (BO twig).

   The attached options are rendered as a table here (and not with the list-group partial the product
   and category tabs share) because this block sits in the middle of the template edit page, where the
   surrounding sections are all tables. #}
{% set d = 'option' %}
{% set template_tab_url = path('admin.configuration.templates.update', {current_tab: 'template_option_tab', template_id: template_id}) %}

<div class="card mt-4" id="options-container">
    <div class="card-header">
        <a href="{{ path('admin.module.configure', {module_code: 'Option'}) }}">{{ 'Paid options'|trans({}, d) }}</a>
    </div>
    <div class="card-body">
        <p class="text-muted">{{ 'Manage the paid options for products using this template.'|trans({}, d) }}</p>

        {{ include('Option/include/_attach-option-form.html.twig', {
            form: form,
            set_route: 'admin_option_template_option_templates_set',
            hidden_fields: {
                template_id: template_id,
                success_url: template_tab_url,
                error_url: template_tab_url,
            },
            label: null,
            help: null,
        }, with_context = false) }}

        {% if attached_options|length %}
            <div class="table-responsive">
                <table class="table table-striped table-sm align-middle">
                    <thead>
                        <tr>
                            <th>{{ 'Reference'|trans({}, d) }}</th>
                            <th>{{ 'Option title'|trans({}, d) }}</th>
                            <th class="text-end">{{ 'Price'|trans({}, d) }}</th>
                            <th class="text-end">{{ 'Actions'|trans({}, d) }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for option in attached_options %}
                            <tr>
                                <td>{{ option.ref }}</td>
                                <td><a href="{{ path('admin_option_update_option_view', {option_id: option.productId}) }}">{{ option.title }}</a></td>
                                <td class="text-end">{{ option.price is not null ? option.price|number_format(2, '.', ' ') : '—' }}</td>
                                <td class="text-end">
                                    {% if is_granted('DELETE', {resource: 'admin.module', module: 'Option'}) %}
                                        {# |e('js') : an apostrophe in the translation would otherwise be decoded
                                           before the JS is parsed and the delete would submit unconfirmed. #}
                                        <form method="post" action="{{ path('admin_option_template_option_template_delete') }}?_token={{ assignToken() }}"
                                              class="d-inline" onsubmit="return confirm('{{ 'Remove this option from the template?'|trans({}, d)|e('js') }}')">
                                            <input type="hidden" name="template_id" value="{{ template_id }}">
                                            <input type="hidden" name="option_product_id" value="{{ option.optionProductId }}">
                                            <button type="submit" class="btn btn-danger btn-sm" title="{{ 'Delete this option'|trans({}, d) }}">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="alert alert-info mb-0">{{ 'No option attached to this template yet.'|trans({}, d) }}</div>
        {% endif %}
    </div>
</div>
