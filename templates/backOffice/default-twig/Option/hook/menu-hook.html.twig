{# Side-nav entry for the Option module, injected through the main.in-top-menu-items hook.

   The hook is rendered inside <ul class="nav flex-column"> in _side_nav.html.twig, so the
   fragment MUST follow the Bootstrap 5 markup the native entries use — <li class="nav-item">
   plus <a class="nav-link"> — otherwise the item shows up unstyled. Icons come from Bootstrap
   Icons (bi bi-*); the Bootstrap 3 glyphicon font this template used to reference does not
   exist in the Twig back-office. #}
{# The active state is computed against hardcoded '/admin/...' paths, exactly like the native
   entries of _side_nav.html.twig: the BO's path() Twig function (TwigEngine URLExtension)
   generates ABSOLUTE urls, so comparing it to app.request.pathInfo can never match. pathInfo is
   safe even behind BackOfficePath — the incoming custom prefix is rewritten to /admin before
   routing, and only the response HTML is rewritten back. /admin/module/Option (reachable through
   Modules > Configure) shows the same screen, so the entry lights up there too. #}
{% set d = 'option' %}
{% set current_path = app.request.pathInfo|default('') %}
{% set is_active = current_path == '/admin/option'
    or current_path starts with '/admin/option/'
    or current_path == '/admin/module/Option' %}

<li class="nav-item" id="option">
    <a class="nav-link {{ is_active ? 'active' : '' }}"
       title="{{ 'Options'|trans({}, d) }}"
       href="{{ path('admin_option_config_view') }}">
        <i class="bi bi-list-check me-2" aria-hidden="true"></i>
        <span class="item-text">{{ 'Options'|trans({}, d) }}</span>
    </a>
</li>
