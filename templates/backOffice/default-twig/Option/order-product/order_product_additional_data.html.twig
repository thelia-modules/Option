{# Options bought with an order product line (BO twig). #}
<div class="small mt-1" data-testid="order-item-options">
    <span class="text-muted">{{ options_ordered }}</span>
    <ul class="list-unstyled mb-0">
        {% for option in options %}
            <li>{{ option.title }}{% if option.value %}: <strong>{{ option.value }}</strong>{% endif %}</li>
        {% endfor %}
    </ul>
</div>
