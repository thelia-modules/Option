{# Options tab content for the product edit page (BO twig). #}
{% set d = 'option' %}
{% set product_tab_url = path('admin.products.update', {current_tab: 'product_option_tab', product_id: product_id}) %}

<div class="option-product-tab">
    <h4 class="mb-3">{{ 'Paid options management'|trans({}, d) }}</h4>

    {# Attach an option to the product #}
    {{ include('Option/include/_attach-option-form.html.twig', {
        form: form,
        set_route: 'admin_option_product_option_product_set',
        hidden_fields: {
            product_id: product_id,
            success_url: product_tab_url,
            error_url: product_tab_url,
        },
        label: 'Available options'|trans({}, d),
        help: null,
    }, with_context = false) }}

    {# Options already attached to the product #}
    {{ include('Option/include/_attached-options.html.twig', {
        attached_options: attached_options,
        delete_route: 'admin_option_product_option_product_delete',
        delete_fields: {
            product_id: product_id,
            force: 0,
        },
        confirm_message: 'Remove this option from the product?'|trans({}, d),
        empty_message: 'No option attached to this product yet.'|trans({}, d),
    }, with_context = false) }}
</div>
