{# Options tab content for the product edit page (BO twig). #}
{% set d = 'option' %}

<div class="option-product-tab">
    <h4 class="mb-3">{{ 'Paid options management'|trans({}, d) }}</h4>

    {% if is_granted('UPDATE', {resource: 'admin.module', module: 'Option'}) %}

        {# The form only lists the options this product does not already carry. #}
        {% set form = getForm('product_available_option_form', {product_id}) %}
        {% form_theme form with bo_form_themes only %}

        {% if form.option_id.vars.choices is empty %}
            <div class="alert alert-secondary mb-4">{{ 'Every available option is already attached to this product.'|trans({}, d) }}</div>
        {% else %}
            {{ form_start(form, {
                action: path('admin_option_product_option_product_set'),
                method: 'POST',
                attr :{ class: 'mb-4'}
            }) }}

            <input type="hidden" name="{{ field_name(form.product_id) }}" value="{{ product_id }}">
            <input type="hidden" name="{{ field_name(form.success_url) }}" value="{{ redirect_url }}">
            <input type="hidden" name="{{ field_name(form.error_url) }}" value="{{ redirect_url }}">

            {{form_rest(form) }}

             <div class="input-group">
                <button class="btn btn-primary" type="submit">{{ 'Apply'|trans({}, d) }}</button>
            </div>

            {{form_end(form) }}
        {% endif %}

    {% endif %}

    {# Options already attached to the product #}
    {% if attached_options|length %}
        <div class="list-group">
            {% for option in attached_options %}
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <span>
                        <strong>{{ option.title }}</strong> — {{ option.ref }}
                        {% if option.price is not null %}
                            <span class="text-warning ms-2">{{ option.price|number_format(2, '.', ' ') }}</span>
                        {% endif %}
                    </span>
                    <span class="text-nowrap">
                        <a class="btn btn-outline-secondary btn-sm" href="{{ path('admin_option_update_option_view', {option_id: option.productId}) }}"
                           title="{{ 'View this option'|trans({}, d) }}">
                            <i class="bi bi-eye"></i>
                        </a>
                        {% if is_granted('DELETE', {resource: 'admin.module', module: 'Option'}) %}
                            <form method="post" action="{{ path('admin_option_product_option_product_delete') }}?_token={{ assignToken() }}"
                                  class="d-inline" onsubmit="return confirm('{{ 'Remove this option from the product?'|trans({}, d) }}')">
                                <input type="hidden" name="option_product_id" value="{{ option.optionProductId }}">
                                <input type="hidden" name="{{ field_name(form.success_url) }}" value="{{ redirect_url }}">
                                <input type="hidden" name="{{ field_name(form.error_url) }}" value="{{ redirect_url }}">
                                <input type="hidden" name="product_id" value="{{ product_id }}">
                                <input type="hidden" name="force" value="0">
                                <button type="submit" class="btn btn-danger btn-sm" title="{{ 'Delete this option'|trans({}, d) }}">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        {% endif %}
                    </span>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="alert alert-info">{{ 'No option attached to this product yet.'|trans({}, d) }}</div>
    {% endif %}
</div>
