{# Options tab content for the category edit page (BO twig). #}
{% set d = 'option' %}
{% set category_tab_url = path('admin.categories.update', {current_tab: 'category_option_tab', category_id: category_id}) %}

<div class="option-category-tab">
    <h4 class="mb-3">{{ 'Paid options management'|trans({}, d) }}</h4>

    {# Attach an option to every product of the category #}
    {{ include('Option/include/_attach-option-form.html.twig', {
        form: form,
        set_route: 'admin_option_category_option_category_set',
        hidden_fields: {
            category_id: category_id,
            success_url: category_tab_url,
            error_url: category_tab_url,
        },
        label: 'Available options'|trans({}, d),
        help: 'The option will be applied to all products of this category.'|trans({}, d),
    }, with_context = false) }}

    {# Options already attached to the category #}
    {{ include('Option/include/_attached-options.html.twig', {
        attached_options: attached_options,
        delete_route: 'admin_option_category_option_category_delete',
        delete_fields: {
            category_id: category_id,
            delete_all: 0,
        },
        confirm_message: 'Remove this option from the category products?'|trans({}, d),
        empty_message: 'No option attached to this category yet.'|trans({}, d),
    }, with_context = false) }}
</div>
