{# Options bought under this order line, as a cross-reference.

   Deliberately not "included": placing the order gave each option its own line and took
   its amount off this one (OptionOrderProductService::handleOrderProduct), so the price
   shown on this card does not contain them. Saying otherwise would have the customer
   count them twice.

   Only classes the theme already emits: a module template is not scanned by the theme's
   Tailwind (@import "tailwindcss" source(none) in assets/styles/app.css). #}
{% set d = 'option' %}

<div class="mt-1 mb-6 paragraph-6 text-grey">
    <span>{{ 'Options ordered with this product:'|trans({}, d) }}</span>

    <ul class="mt-1 flex flex-col gap-1">
        {% for option in options %}
            <li class="flex items-center justify-between gap-2">
                <span class="min-w-0">
                    {{- option.title -}}
                    {%- if option.value %} <span class="text-grey-dark">{{ option.value }}</span>{% endif -%}
                    {#- The cards beside this one print a unit price; this is a line amount,
                        so the quantity it covers is spelled out rather than assumed. -#}
                    {%- if option.quantity > 1 %} <span>× {{ option.quantity }}</span>{% endif -%}
                </span>
                <span class="shrink-0">{{ option.price|format_currency('EUR', locale: lang_code) }}</span>
            </li>
        {% endfor %}
    </ul>
</div>
